{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/signage/**",
              "ui_kits/signage/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Oswald|Playfair Display|Barlow Semi Condensed|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Oswald, Playfair Display, Barlow Semi Condensed, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|brass|ghost)$/]",
        "message": "<Chip> tone must be one of 'accent' | 'brass' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilmTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:ordinal|title|meta|style|key|ref|className|style|children)$/]",
        "message": "<FilmTile> doesn't accept that prop. Declared props: ordinal, title, meta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KioskSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|kicker|title|teaser|detail|key|ref|className|style|children)$/]",
        "message": "<KioskSection> doesn't accept that prop. Declared props: index, kicker, title, teaser, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarqueeHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|meta|badge|style|key|ref|className|style|children)$/]",
        "message": "<MarqueeHeader> doesn't accept that prop. Declared props: eyebrow, title, meta, badge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|kicker|title|lead|children|emphasis|underline|style|key|ref|className|style|children)$/]",
        "message": "<SectionPanel> doesn't accept that prop. Declared props: index, kicker, title, lead, children, emphasis, underline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShotRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|target|children|marker|style|key|ref|className|style|children)$/]",
        "message": "<ShotRow> doesn't accept that prop. Declared props: label, target, children, marker, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShowReelScene'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|kind|game|eyebrow|title|meta|proTip|gameName|holdMs|render|key|ref|className|style|children)$/]",
        "message": "<ShowReelScene> doesn't accept that prop. Declared props: id, kind, game, eyebrow, title, meta, proTip, gameName, holdMs, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShowReelScene'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:machine|general|overview)$/]",
        "message": "<ShowReelScene> kind must be one of 'machine' | 'general' | 'overview'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignageFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:proTip|proTipLabel|gameName|gameLogo|rfpcBadge|style|key|ref|className|style|children)$/]",
        "message": "<SignageFooter> doesn't accept that prop. Declared props: proTip, proTipLabel, gameName, gameLogo, rfpcBadge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:game|header|footer|children|fit|style|key|ref|className|style|children)$/]",
        "message": "<StageFrame> doesn't accept that prop. Declared props: game, header, footer, children, fit, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
